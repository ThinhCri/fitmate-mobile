# Fitmate Mobile — Backend integration config (placeholders only)
# Copy thành `.env` cho local/staging. KHÔNG commit giá trị thật.

# Base URL cho staging
EXPO_PUBLIC_API_BASE_URL=https://staging-api.fitmate.vn/api/v1

# Base URL cho local dev (Android emulator trỏ về host)
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Client presentation defaults are fail-closed. Backend /system/capabilities is authoritative.
# These public values are never authorization and must not contain secrets.
EXPO_PUBLIC_FEATURE_AI=false
EXPO_PUBLIC_FEATURE_PAYMENT=false
EXPO_PUBLIC_FEATURE_PUSH=false

# Android release upload key (set these in the build shell, never in EXPO_PUBLIC_*).
# Keep the keystore outside the repository and back it up securely. Release fails without all four.
# FITMATE_UPLOAD_STORE_FILE=C:/secure/fitmate-upload.jks
# FITMATE_UPLOAD_STORE_PASSWORD=<secret>
# FITMATE_UPLOAD_KEY_ALIAS=fitmate-upload
# FITMATE_UPLOAD_KEY_PASSWORD=<secret>

# Opt-in GA4 Android native build only. Download google-services.json from the
# Firebase Android app (package vn.fitmate.app), place it in mobile/, then set:
# FITMATE_FIREBASE_ANDROID_FILE=./google-services.json
# This is a build-time path, not a service-account private key. Expo Go stays analytics-disabled.
