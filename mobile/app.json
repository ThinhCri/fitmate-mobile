{
  "expo": {
    "name": "Fitmate",
    "slug": "fitmate-mobile",
    "version": "0.1.15",
    "orientation": "default",
    "scheme": "fitmate",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.fitmate.app"
    },
    "android": {
      "versionCode": 16,
      "package": "vn.fitmate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#F43F5E",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "./plugins/withAndroidReleaseOptimization",
      "./plugins/withAndroidAdaptiveWindow",
      "./plugins/withAndroidMaterialCompatibility",
      "./plugins/withAndroidBrandIcon",
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-iap",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fitmate cần quyền máy ảnh để chụp món ăn và ảnh đại diện.",
          "photosPermission": "Fitmate cần quyền thư viện ảnh để chọn ảnh món ăn và ảnh đại diện."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
