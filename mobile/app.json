{
  "expo": {
    "name": "Fitmate",
    "slug": "fitmate-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitmate",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.fitmate.app"
    },
    "android": {
      "package": "vn.fitmate.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fitmate cần quyền máy ảnh để chụp món ăn và ảnh đại diện.",
          "photosPermission": "Fitmate cần quyền thư viện ảnh để chọn ảnh món ăn và ảnh đại diện."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
